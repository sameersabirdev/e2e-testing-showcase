{
  "name": "e2e-testing-showcase",
  "version": "1.0.0",
  "description": "End-to-end test automation showcase for saucedemo — the same suite implemented in both Cypress (JavaScript) and Playwright (TypeScript), with the Page Object Model, fixtures, custom commands, HTML reporting, and GitHub Actions CI.",
  "author": "Sameer Sabir",
  "license": "MIT",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "pw:test": "playwright test",
    "pw:test:headed": "playwright test --headed",
    "pw:report": "playwright show-report",
    "pw:install": "playwright install --with-deps",
    "test": "npm run cy:run && npm run pw:test",
    "lint": "eslint ."
  },
  "keywords": [
    "e2e-testing",
    "test-automation",
    "cypress",
    "playwright",
    "page-object-model",
    "qa-automation",
    "end-to-end-testing"
  ],
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.20.1",
    "cypress": "^13.15.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "typescript": "^5.6.0"
  }
}
